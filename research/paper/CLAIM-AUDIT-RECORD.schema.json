{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://god-agent.local/schemas/rt95-paper-claim-audit-record-v1.json",
  "title": "RT95 paper claim audit record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "status", "claimId", "claimText", "claimType",
    "manuscriptLocator", "claimBoundary", "candidate", "evidenceItems",
    "analysis", "review", "closure"
  ],
  "properties": {
    "schemaVersion": { "const": "rt95-paper-claim-audit-record-v1" },
    "status": { "enum": ["CodeVerified", "Collected", "Reviewed", "Verified", "NotVerified"] },
    "claimId": { "$ref": "#/$defs/id" },
    "claimText": { "type": "string", "minLength": 1 },
    "claimType": { "enum": ["method", "result", "reproduction", "citation", "limitation"] },
    "manuscriptLocator": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "section", "lineOrTable"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)" },
        "section": { "type": "string", "minLength": 1 },
        "lineOrTable": { "type": "string", "minLength": 1 }
      }
    },
    "claimBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["allowedClaim", "forbiddenClaim"],
      "properties": {
        "allowedClaim": { "type": "string", "minLength": 1 },
        "forbiddenClaim": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateLabel", "preregistrationPayloadSha256", "preregistrationSourceSha256", "evidenceManifestSha256", "sampledAt"],
      "properties": {
        "candidateLabel": { "type": "string", "minLength": 1 },
        "preregistrationPayloadSha256": { "$ref": "#/$defs/sha256OrTodo" },
        "preregistrationSourceSha256": { "$ref": "#/$defs/sha256OrTodo" },
        "evidenceManifestSha256": { "$ref": "#/$defs/sha256OrTodo" },
        "sampledAt": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceItems": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path", "sha256", "generatedBy", "locator", "verified"],
        "properties": {
          "kind": { "enum": ["preregistration", "raw", "oracle", "statistics", "artifact", "figure", "citation", "reproduction", "review"] },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)" },
          "sha256": { "$ref": "#/$defs/sha256OrTodo" },
          "generatedBy": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "verified": { "type": "boolean" }
        }
      }
    },
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "direction", "alpha", "multiplicityFamily", "denominatorAndMissingRule", "negativeNullFailurePolicy"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "minLength": 1 },
        "alpha": { "type": "string", "minLength": 1 },
        "multiplicityFamily": { "type": "string", "minLength": 1 },
        "denominatorAndMissingRule": { "type": "string", "minLength": 1 },
        "negativeNullFailurePolicy": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["round", "reviewerNameOrOrg", "nonAuthor", "conflictOfInterest", "scope", "reviewedAt", "decision", "issues"],
      "properties": {
        "round": { "enum": ["R0", "R1", "R2"] },
        "reviewerNameOrOrg": { "type": "string", "minLength": 1 },
        "nonAuthor": { "type": "boolean" },
        "conflictOfInterest": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["method", "statistics", "citations", "ethics", "full-manuscript"] } },
        "reviewedAt": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["Accepted", "Revise", "Rejected", "NotReviewed"] },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
      }
    },
    "closure": {
      "type": "object", "additionalProperties": false,
      "required": ["p0Open", "p1Open", "artifactAndFigureConsistency", "authorApproval"],
      "properties": {
        "p0Open": { "type": "integer", "minimum": 0 },
        "p1Open": { "type": "integer", "minimum": 0 },
        "artifactAndFigureConsistency": { "enum": ["Pass", "Fail", "NotRun"] },
        "authorApproval": { "enum": ["Approved", "Rejected", "NotRun"] }
      }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["Reviewed", "Verified"] }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "nonAuthor": { "const": true }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "sha256OrTodo": { "type": "string", "pattern": "^(?:[0-9a-f]{64}|TODO|NotIncluded)$" },
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["issueId", "severity", "locator", "description", "disposition", "reverification", "status"],
      "properties": {
        "issueId": { "$ref": "#/$defs/id" },
        "severity": { "enum": ["P0", "P1", "P2"] },
        "locator": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "disposition": { "type": "string", "minLength": 1 },
        "reverification": { "type": "string", "minLength": 1 },
        "status": { "enum": ["Open", "Closed"] }
      }
    }
  }
}
