{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hanlaining/agent-learn/research/runtime-e2e-report.schema.json",
  "title": "God Agent Runtime-E2E implementation-check report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmark", "fixtureSeed", "generatorVersion", "shard", "variants", "runStartedAt", "implementation", "methodology", "environment", "summaries", "cases"],
  "properties": {
    "schemaVersion": { "const": "runtime-e2e-report-v1" },
    "benchmark": { "enum": ["Runtime-E2E-GATE-30", "Runtime-E2E-GATE-100"] },
    "fixtureSeed": { "type": "integer" },
    "generatorVersion": { "const": "runtime-e2e-generator-v1" },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "total"],
      "properties": { "index": { "type": "integer", "minimum": 1 }, "total": { "type": "integer", "minimum": 1 } }
    },
    "variants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["baseline", "no-wal", "no-recovery", "no-lease"] } },
    "runStartedAt": { "type": "string", "format": "date-time" },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "persistence", "runtimeClasses", "protocolSimulatorUsed"],
      "properties": {
        "check": { "const": "production-runtime" },
        "persistence": { "const": "JsonFileRuntimePersistence" },
        "runtimeClasses": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
        "protocolSimulatorUsed": { "const": false }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "tool", "latency", "claims"],
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "realApiCalls", "credentialsRead"],
          "properties": { "kind": { "const": "deterministic-fake" }, "realApiCalls": { "const": false }, "credentialsRead": { "const": false } }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "effects"],
          "properties": { "kind": { "const": "deterministic-fake" }, "effects": { "const": "local-temporary-journal" } }
        },
        "latency": { "const": "measured local wall-clock; not production capacity" },
        "claims": { "const": "implementation correctness only; not real-provider or production-capacity evidence" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "node", "local"],
      "properties": { "platform": { "type": "string", "minLength": 1 }, "arch": { "type": "string", "minLength": 1 }, "node": { "type": "string", "minLength": 1 }, "local": { "const": true } }
    },
    "summaries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/summary" } },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "total", "rate"],
      "properties": { "count": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 }, "rate": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "cases", "taskSuccess", "recoverySuccess", "duplicateModelCalls", "duplicateToolEffects", "unknownOutcome", "evidenceCompleteness", "wallClockMs"],
      "properties": {
        "variant": { "enum": ["baseline", "no-wal", "no-recovery", "no-lease"] },
        "cases": { "type": "integer", "minimum": 0 },
        "taskSuccess": { "$ref": "#/$defs/rate" },
        "recoverySuccess": { "$ref": "#/$defs/rate" },
        "duplicateModelCalls": { "type": "integer", "minimum": 0 },
        "duplicateToolEffects": { "type": "integer", "minimum": 0 },
        "unknownOutcome": { "$ref": "#/$defs/rate" },
        "evidenceCompleteness": { "type": "number", "minimum": 0, "maximum": 1 },
        "wallClockMs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "total", "p50", "p95"],
          "properties": { "kind": { "const": "measured-local-wall-clock" }, "total": { "type": "number", "minimum": 0 }, "p50": { "type": "number", "minimum": 0 }, "p95": { "type": "number", "minimum": 0 } }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "caseIndex", "scenarioSeed", "family", "checkpoint", "variant", "taskSuccess", "recoveryAttempted", "recoverySuccess", "snapshotReloaded", "stateFileWrites", "stateFileLoads", "modelCalls", "duplicateModelCalls", "toolEffects", "duplicateToolEffects", "unknownOutcome", "evidenceRequired", "evidenceProduced", "evidenceCompleteness", "wallClockDurationMs", "recoveryResult", "productionClasses", "invariants", "failureCodes"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "caseIndex": { "type": "integer", "minimum": 0 },
        "scenarioSeed": { "type": "integer", "minimum": 0 },
        "family": { "enum": ["model-response-window", "tool-effect-window", "return-parent-feedback", "workflow-stage", "snapshot-reload", "multi-instance-lease"] },
        "checkpoint": { "type": "string", "minLength": 1 },
        "variant": { "enum": ["baseline", "no-wal", "no-recovery", "no-lease"] },
        "taskSuccess": { "type": "boolean" },
        "recoveryAttempted": { "type": "boolean" },
        "recoverySuccess": { "type": ["boolean", "null"] },
        "snapshotReloaded": { "type": "boolean" },
        "stateFileWrites": { "type": "integer", "minimum": 1 },
        "stateFileLoads": { "type": "integer", "minimum": 1 },
        "modelCalls": { "type": "integer", "minimum": 0 },
        "duplicateModelCalls": { "type": "integer", "minimum": 0 },
        "toolEffects": { "type": "integer", "minimum": 0 },
        "duplicateToolEffects": { "type": "integer", "minimum": 0 },
        "unknownOutcome": { "type": "boolean" },
        "evidenceRequired": { "type": "integer", "minimum": 1 },
        "evidenceProduced": { "type": "integer", "minimum": 0 },
        "evidenceCompleteness": { "type": "number", "minimum": 0, "maximum": 1 },
        "wallClockDurationMs": { "type": "number", "minimum": 0 },
        "recoveryResult": { "type": "string" },
        "productionClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "failureCodes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
